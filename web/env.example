# ============================================================================
# Saku v2 — copy to `.env.local` and fill in. `.env*` is gitignored; this file
# (no leading dot) is the committed template.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase — the NEW v2 project (schema: supabase/schema/saku_v2_schema*.sql)
# Settings > API in the dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — every table except compliance_policies is
# unreadable without it, which is the intended design. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Saku session token (HS256, issued after OTP verification).
#
# Delivered as an httpOnly cookie, never handed to page script — see lib/session.ts.
# Rotating this signs everyone out, which is the emergency lever if it ever leaks.
# Generate: openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------------
# OTP
# ---------------------------------------------------------------------------
# WhatsApp gateway that delivers the code. This is the only component that ever
# sees the plain phone number.
FONNTE_TOKEN=

# ---------------------------------------------------------------------------
# Payment gateway currencies
# ---------------------------------------------------------------------------
# Which currencies the Xendit account can actually put on a charge — what Xendit
# calls the *presentment* currency. It is fixed by the country the merchant account
# is incorporated in, so an Indonesia-scoped account can only present IDR no matter
# how many currency balances it opens. Prices are still shown in the user's own
# currency; anything not listed here is billed in the first entry instead, and the
# top up screen names that amount before the user pays.
# Comma-separated ISO 4217. Defaults to IDR when unset.
# Once Xendit enables another currency for the account, add it here — no code change.
XENDIT_PRESENTMENT_CURRENCIES=IDR

# Pepper for HMAC-ing OTP codes before they hit `otp_challenges.code_hmac`.
# Without a secret pepper, a six-digit code's hash is brute-forceable instantly.
# Generate: openssl rand -hex 32
OTP_HMAC_PEPPER=

# Numbers that skip the WhatsApp send and accept a fixed code, so the signup flow
# can be walked as a user in another country without a foreign WhatsApp account.
# Format: <international digits>:<code>, comma-separated. The code must be exactly
# OTP_LENGTH digits (lib/otp-shape.ts) or the entry is skipped.
# IGNORED IN PRODUCTION — see lib/otp-test-numbers.ts. Leave blank unless testing.
# Example: OTP_TEST_NUMBERS=60123456789:123456,6591234567:123456
OTP_TEST_NUMBERS=

# ---------------------------------------------------------------------------
# BNB Smart Chain Testnet (PRD Section 4)
# Deployed addresses: ../contract/deployments/bscTestnet.json
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=97
# The old data-seed-prebsc-*.binance.org endpoints refuse connections.
NEXT_PUBLIC_RPC_URL=https://bsc-testnet-rpc.publicnode.com
NEXT_PUBLIC_BLOCK_EXPLORER=https://testnet.bscscan.com

NEXT_PUBLIC_ESCROW_ADDRESS=0xe9Bc98E5Ac1942AbE4E79A4219868FF0351579A0
NEXT_PUBLIC_MOCK_USDC_ADDRESS=0x3d2937A6cDb76a1B199b87302D112D584795d3b1
NEXT_PUBLIC_STABLE_TOKEN_ADDRESS=0xD12196E766F86F6Fc352d5CECe7637bCd9026a83

# Backend settler that calls settleOfframp (PRD 5.1 step 5-6). Server-only.
# Must be the address in SakuOfframpEscrow.settler() or every settlement reverts
# with NotSettler.
SETTLER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Privy — wallet custody and signing.
#
# Replaced Turnkey on 2026-09-09. Same posture (the private key never exists in
# this app; the server can only ask for a signature), different economics:
# Turnkey's free tier is 25 signatures/month, Privy's is 50,000.
#
# From dashboard.privy.io:
#   PRIVY_APP_ID / PRIVY_APP_SECRET      Settings -> Basics
#   PRIVY_AUTHORIZATION_KEY              Wallets -> Authorization keys -> New key
#                                        (paste as given, the "wallet-auth:" prefix
#                                        is stripped in lib/privy.ts)
#   PRIVY_AUTHORIZATION_KEY_ID           the ID column on that same page
#
# The authorization key is a P-256 private key Privy never sees — it holds only
# the public half. It is a deliberate second factor: a leaked app secret alone
# cannot move funds, because every wallet request must also be signed with this.
# ---------------------------------------------------------------------------
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=
PRIVY_AUTHORIZATION_KEY_ID=

# ---------------------------------------------------------------------------
# Xendit — the fiat-in leg of top up.
#
# The payment is real, what gets credited is a testnet token paid out of the
# admin treasury. Keys come from dashboard.xendit.co > Settings > Developers >
# API Keys (use a TEST-mode secret key). The webhook token is under Settings >
# Developers > Webhooks; it is what the callback route checks, so leaking it
# lets anyone forge a paid callback and mint themselves a payout.
# ---------------------------------------------------------------------------
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Gemini (app/api/ocr/route.ts — split-bill receipt scan). Get a free key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Deliberately absent, and must stay absent:
#
#   ENCRYPTION_KEY     — v1 wrapped user private keys with this. v2 holds no key
#                        material, so there is nothing to encrypt. The three modules
#                        that still read it were unreferenced and have been deleted.
#   TURNKEY_*          — superseded by Privy. lib/turnkey.ts is gone; leaving the
#                        credentials configured only keeps a live signing key around
#                        for a provider nothing calls.
#   ADMIN_PRIVATE_KEY  — v1 signed registrations and funded gas from a hot admin
#                        wallet. That is the single point of failure PRD Section 1
#                        exists to remove.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Platform fees, in basis points (100 bps = 1%).
#
# Top up adds the fee on top of the tokens; off-ramp deducts it from the amount.
# Saku-to-Saku transfers and QR payments are free by design — see lib/fees.ts.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FEE_TOPUP_BPS=70
NEXT_PUBLIC_FEE_OFFRAMP_BPS=150

# SakuStaking — stake USDC, earn USDC from a funded reward stream.
NEXT_PUBLIC_STAKING_ADDRESS=0xcF651Cd85b64B54f0b2B48F1D74A4B475cee1E9a

# ---------------------------------------------------------------------------
# Web Push (VAPID).
#
# Identifies this server to the browser push services (FCM, Mozilla, WNS) that
# actually deliver a notification. Generate a fresh pair with:
#
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# The public key ships to the browser — it is baked into the subscription every
# client creates, so rotating it invalidates every stored subscription. The
# private key is what signs each send; treat it like SETTLER_PRIVATE_KEY.
# VAPID_SUBJECT must be a mailto: or https: URL the push services can reach.
# With any of the three unset, pushes are skipped silently and the in-app
# notification centre is unaffected (see lib/push.ts).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@saku.app

# Applies to every on-chain movement the user signs — transfer, QR payment,
# split-bill share, packet funding. Added on top, never deducted. 0.3% by
# default: unlike top up and off-ramp there is no third-party cost behind these,
# only the gas Saku sponsors.
NEXT_PUBLIC_FEE_TRANSFER_BPS=30

# ---------------------------------------------------------------------------
# Signing limits.
#
# The most USDC one account can have signed out of its wallet in a rolling 24
# hours (lib/spend-limits.ts). This is a blast-radius limit, not a product
# feature: a session is enough to authorise a payment, so this is what bounds
# what a session someone else got hold of can move before anyone notices.
# Set it above what a real user does in a day and below what losing hurts.
# Defaults to 2000 when unset — deliberately a number, never "unlimited".
# ---------------------------------------------------------------------------
SAKU_DAILY_SIGN_CAP_USDC=2000
