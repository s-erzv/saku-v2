# ============================================================================
# Saku v2 — copy to `.env.local` and fill in. `.env*` is gitignored; this file
# (no leading dot) is the committed template.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase — the NEW v2 project (schema: supabase/schema/saku_v2_schema*.sql)
# Settings > API in the dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — every table except compliance_policies is
# unreadable without it, which is the intended design. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Saku session token (HS256, issued after OTP verification)
# Generate: openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------------
# OTP
# ---------------------------------------------------------------------------
# WhatsApp gateway that delivers the code. This is the only component that ever
# sees the plain phone number.
FONNTE_TOKEN=

# Pepper for HMAC-ing OTP codes before they hit `otp_challenges.code_hmac`.
# Without a secret pepper, a 4-digit code's hash is brute-forceable instantly.
# Generate: openssl rand -hex 32
OTP_HMAC_PEPPER=

# ---------------------------------------------------------------------------
# Turnkey key management (PRD Fase 4, revised) — app.turnkey.com
# See docs/mpc-setup.md for the exact dashboard steps.
# ---------------------------------------------------------------------------
TURNKEY_ORGANIZATION_ID=
# Server-side API keypair. Registered as the root user of every sub-organization this app
# creates, which is what lets it sign for any user's wallet later — never send these to the
# browser.
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_BASE_URL=https://api.turnkey.com

# ---------------------------------------------------------------------------
# BNB Smart Chain Testnet (PRD Section 4)
# Deployed addresses: ../contract/deployments/bscTestnet.json
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=97
# The old data-seed-prebsc-*.binance.org endpoints refuse connections.
NEXT_PUBLIC_RPC_URL=https://bsc-testnet-rpc.publicnode.com
NEXT_PUBLIC_BLOCK_EXPLORER=https://testnet.bscscan.com

NEXT_PUBLIC_ESCROW_ADDRESS=0xe9Bc98E5Ac1942AbE4E79A4219868FF0351579A0
NEXT_PUBLIC_MOCK_USDC_ADDRESS=0x3d2937A6cDb76a1B199b87302D112D584795d3b1
NEXT_PUBLIC_STABLE_TOKEN_ADDRESS=0xD12196E766F86F6Fc352d5CECe7637bCd9026a83

# Backend settler that calls settleOfframp (PRD 5.1 step 5-6). Server-only.
# Must be the address in SakuOfframpEscrow.settler() or every settlement reverts
# with NotSettler.
SETTLER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Xendit — the fiat-in leg of top up.
#
# The payment is real, what gets credited is a testnet token paid out of the
# admin treasury. Keys come from dashboard.xendit.co > Settings > Developers >
# API Keys (use a TEST-mode secret key). The webhook token is under Settings >
# Developers > Webhooks; it is what the callback route checks, so leaking it
# lets anyone forge a paid callback and mint themselves a payout.
# ---------------------------------------------------------------------------
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Deliberately absent, and must stay absent:
#
#   ENCRYPTION_KEY     — v1 wrapped user private keys with this. v2 holds no key
#                        material, so there is nothing to encrypt.
#   ADMIN_PRIVATE_KEY  — v1 signed registrations and funded gas from a hot admin
#                        wallet. That is the single point of failure PRD Section 1
#                        exists to remove.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Platform fees, in basis points (100 bps = 1%).
#
# Top up adds the fee on top of the tokens; off-ramp deducts it from the amount.
# Saku-to-Saku transfers and QR payments are free by design — see lib/fees.ts.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FEE_TOPUP_BPS=70
NEXT_PUBLIC_FEE_OFFRAMP_BPS=150

# SakuStaking — stake USDC, earn USDC from a funded reward stream.
NEXT_PUBLIC_STAKING_ADDRESS=0xcF651Cd85b64B54f0b2B48F1D74A4B475cee1E9a
